{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dr-console",
      "runtimeExecutable": "C:/Program Files/MATLAB/R2026a/bin/matlab.exe",
      "runtimeArgs": [
        "-batch",
        "cd convrt_matlab; s = launch_web('Port', 8000, 'Background', true, 'OpenBrowser', false); while true, pause(0.5); end"
      ],
      "port": 8000
    },
    {
      "name": "dr-console-python",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "drscreen.api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--app-dir",
        "src"
      ],
      "port": 8000
    },
    {
      "name": "prototype",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8777",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8777
    }
  ]
}
