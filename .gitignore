# ---------------------------------------------------------------------------
# Environments and build artefacts
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# MATLAB / Simulink caches and autosaves
slprj/
*.slxc
*.asv
*.autosave

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# ---------------------------------------------------------------------------
# Data: never committed.
# ---------------------------------------------------------------------------
# data/raw/    - the four public corpora. Each requires you to accept its own
#                licence, and none may be redistributed. See docs/DATASETS.md.
# data/cohort* - materialised cohorts (~2.6 GB for 6,000 cases). Regenerate
#                with: python scripts/build_cohort.py
# Anchored: a bare data/ also matches src/drscreen/data/.
/data/

# ---------------------------------------------------------------------------
# Outputs: results ARE committed, bulk intermediates are not.
# ---------------------------------------------------------------------------
# Kept in the repo, because they are the evidence that the pipeline works:
#   outputs/artifacts/    deployable bundle (segmentation + grader + operating point)
#   outputs/validation/   metrics, ablation, model card
#   outputs/simulation/   scenarios, optimisation
#   outputs/reports/      rendered clinical reports and review panels
#
# Excluded: the per-arm training checkpoints (~95 MB) are reproducible from
# scripts/run_all.py and duplicate what outputs/artifacts/ already holds.
outputs/segmentation*/*.pt
outputs/grader_*/*.pt
# Superseded checkpoints kept on disk for recovery, never committed.
outputs/_archive_*/
# Deploy bundles for experiment arms that were not promoted. The validation
# JSON under outputs/validation_*/ is the evidence and IS committed.
outputs/artifacts_*/
# Exception: the pooled four-corpus bundle is committed, because the web
# front-end deploys from it and a checkpoint on its own is not deployable --
# the weights carry no temperature, no isotonic calibrator, no grade
# cut-points and no urgency threshold, so a consumer without pipeline.json
# silently falls back to a 0.5 cut-point that nothing here ever measured.
# Tracked rather than force-added, so `git add -A` keeps picking up changes.
!outputs/artifacts_all/
outputs/benchmark.json
outputs/_*.txt

# Scratch
scripts/_chain.sh
*.onnx

# ---------------------------------------------------------------------------
# Local tool configuration and runtime state
# ---------------------------------------------------------------------------
.claude/
# Reviews logged by whoever ran the console locally; the API creates it on demand.
outputs/audit/
# Regenerated by: python scripts/run_simulation.py --export-matlab outputs/simulink_bridge/
# (the curated copy lives in matlab/simulation/).
outputs/simulink_bridge/
